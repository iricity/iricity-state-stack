{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.iricity.space/state/profiles/satnogs-observation.schema.json",
  "title": "SatNOGS Network observation",
  "description": "Profile satnogs.observation.json/1. An observation object as returned by the SatNOGS Network API (/api/observations/), carried unchanged. Only the identifying and timing keys are required so that older and newer API versions both fit.",
  "type": "object",
  "required": ["id", "start", "ground_station", "norad_cat_id"],
  "properties": {
    "id": { "type": "integer" },
    "start": { "type": "string" },
    "end": { "type": ["string", "null"] },
    "ground_station": { "type": ["integer", "null"] },
    "transmitter": { "type": ["string", "null"] },
    "norad_cat_id": { "type": "integer" },
    "payload": { "type": ["string", "null"] },
    "waterfall": { "type": ["string", "null"] },
    "demoddata": { "type": "array" },
    "station_name": { "type": ["string", "null"] },
    "station_lat": { "type": ["number", "null"] },
    "station_lng": { "type": ["number", "null"] },
    "station_alt": { "type": ["number", "null"] },
    "vetted_status": { "type": ["string", "null"] },
    "status": { "type": ["string", "null"] },
    "waterfall_status": { "type": ["string", "null"] },
    "observer": { "type": ["string", "null"] },
    "rise_azimuth": { "type": ["number", "null"] },
    "set_azimuth": { "type": ["number", "null"] },
    "max_altitude": { "type": ["number", "null"] },
    "tle0": { "type": ["string", "null"] },
    "tle1": { "type": ["string", "null"] },
    "tle2": { "type": ["string", "null"] }
  },
  "additionalProperties": true
}

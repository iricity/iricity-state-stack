{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:frontier-state-protocol:schema:v0.1:profiles/pass-prediction",
  "title": "Predicted pass",
  "description": "Profile pass-prediction.json/1. One predicted contact window between a satellite and an observer, as produced by SGP4 propagation of a CCSDS OMM. Angles in degrees, ranges in kilometres, times in UTC ISO-8601.",
  "type": "object",
  "required": [
    "norad_cat_id",
    "aos",
    "tca",
    "los",
    "max_elevation_deg",
    "duration_seconds"
  ],
  "properties": {
    "norad_cat_id": {
      "type": "integer",
      "minimum": 1
    },
    "object_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "observer_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "observer": {
      "type": "object",
      "required": [
        "latitude",
        "longitude"
      ],
      "properties": {
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "altitude_m": {
          "type": "number"
        }
      },
      "additionalProperties": true
    },
    "aos": {
      "type": "string"
    },
    "tca": {
      "type": "string"
    },
    "los": {
      "type": "string"
    },
    "duration_seconds": {
      "type": "number",
      "minimum": 0
    },
    "max_elevation_deg": {
      "type": "number",
      "minimum": 0,
      "maximum": 90
    },
    "aos_azimuth_deg": {
      "type": "number",
      "minimum": 0,
      "maximum": 360
    },
    "tca_azimuth_deg": {
      "type": "number",
      "minimum": 0,
      "maximum": 360
    },
    "los_azimuth_deg": {
      "type": "number",
      "minimum": 0,
      "maximum": 360
    },
    "tca_range_km": {
      "type": "number",
      "minimum": 0
    },
    "min_elevation_deg": {
      "type": "number",
      "minimum": 0,
      "maximum": 90
    },
    "elements_epoch": {
      "type": "string"
    },
    "elements_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "propagator": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
